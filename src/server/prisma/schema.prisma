generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isAdmin     Boolean  @default(false)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id              Int       @id @default(autoincrement())
  firstName       String
  lastName        String
  middleName      String?
  birthDate       DateTime
  login           String    @unique
  passwordHash    String    @map("password")
  avatarUrl       String?   @map("avatar")
  isAdmin         Boolean   @default(false)
  roleId          Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  role            Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdProducts product[] @relation("ProductCreator")
  createdProcesses technologicalProcess[] @relation("ProcessCreator")
  disabledProcesses technologicalProcess[] @relation("ProcessDisabledBy")

  @@index([roleId])
}

model TypeProduct {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    product[]
}

model materialGroup {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  materials   material[]
}

model operationGroup {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  operations  operation[]
}

model material {
  id              Int           @id @default(autoincrement())
  name            String        @unique
  description     String?
  materialGroupId Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  materialGroup   materialGroup @relation(fields: [materialGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  blanks          blank[]
  products        product[]

  @@index([materialGroupId])
}

model product {
  id            Int                @id @default(autoincrement())
  name          String
  description   String?
  typeProductId Int
  materialId    Int?
  creatorId     Int
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  typeProduct   TypeProduct        @relation(fields: [typeProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  material      material?          @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator       User               @relation("ProductCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  files         productFile[]
  images        productImage[]
  components    productComponent[] @relation("ProductComponents")
  usedIn        productComponent[] @relation("ProductComponentChildren")
  processes     technologicalProcess[]

  @@unique([name, typeProductId, materialId])
  @@index([typeProductId])
  @@index([materialId])
  @@index([creatorId])
}

model productFile {
  id           Int      @id @default(autoincrement())
  productId    Int
  originalName String   @map("originalName")
  size         Int
  mimeType     String?  @map("mimeType")
  storagePath  String   @map("storagePath")
  createdAt    DateTime @default(now())
  product      product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
}

model productImage {
  id           Int      @id @default(autoincrement())
  productId    Int
  originalName String   @map("originalName")
  size         Int
  mimeType     String?  @map("mimeType")
  storagePath  String   @map("storagePath")
  sortOrder    Int      @default(0) @map("sortOrder")
  createdAt    DateTime @default(now())
  product      product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
}

model productComponent {
  id                 Int      @id @default(autoincrement())
  productId          Int
  componentProductId Int
  count              Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            product  @relation("ProductComponents", fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  componentProduct   product  @relation("ProductComponentChildren", fields: [componentProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([productId, componentProductId])
  @@index([componentProductId])
}

model blank {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  materialId  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  material    material @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  processes   technologicalProcess[]

  @@unique([name, materialId])
  @@index([materialId])
}

model technologicalProcess {
  id           Int      @id @default(autoincrement())
  productId    Int
  name         String
  description  String?
  blankId      Int?
  creatorId    Int
  disabledById Int?
  disabledAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  blank        blank?   @relation(fields: [blankId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator      User     @relation("ProcessCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  disabledBy   User?    @relation("ProcessDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  files        technologicalProcessFile[]
  operations   processOperation[]

  @@index([productId])
  @@index([blankId])
  @@index([creatorId])
  @@index([disabledById])
}

model technologicalProcessFile {
  id           Int      @id @default(autoincrement())
  processId    Int
  originalName String   @map("originalName")
  size         Int
  mimeType     String?  @map("mimeType")
  storagePath  String   @map("storagePath")
  createdAt    DateTime @default(now())
  process      technologicalProcess @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([processId])
}

model operation {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  description      String?
  operationGroupId Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  operationGroup   operationGroup  @relation(fields: [operationGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  files            operationFile[]
  workGroups       workGroup[]
  processOperations processOperation[]

  @@index([operationGroupId])
}

model processOperation {
  id          Int      @id @default(autoincrement())
  processId   Int
  operationId Int
  sortOrder   Int      @default(0)
  exit        Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  process     technologicalProcess @relation(fields: [processId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  operation   operation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  files       processOperationFile[]
  steps       processStep[]

  @@unique([processId, operationId])
  @@index([processId])
  @@index([operationId])
  @@index([sortOrder])
}

model processOperationFile {
  id                 Int      @id @default(autoincrement())
  processOperationId Int
  originalName       String   @map("originalName")
  size               Int
  mimeType           String?  @map("mimeType")
  storagePath        String   @map("storagePath")
  createdAt          DateTime @default(now())
  processOperation   processOperation @relation(fields: [processOperationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([processOperationId])
}

model processStep {
  id                 Int      @id @default(autoincrement())
  processOperationId Int
  sortOrder          Int      @default(0)
  name               String
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  processOperation   processOperation @relation(fields: [processOperationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  files              processStepFile[]
  works              processWork[]

  @@index([processOperationId])
  @@index([sortOrder])
}

model processStepFile {
  id           Int      @id @default(autoincrement())
  processStepId Int
  originalName String   @map("originalName")
  size         Int
  mimeType     String?  @map("mimeType")
  storagePath  String   @map("storagePath")
  createdAt    DateTime @default(now())
  processStep  processStep @relation(fields: [processStepId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([processStepId])
}

model processWork {
  id            Int      @id @default(autoincrement())
  processStepId Int
  workId        Int
  sortOrder     Int      @default(0)
  count         Int      @default(1)
  tpz           Float
  tsht          Float
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  processStep   processStep @relation(fields: [processStepId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  work          work        @relation(fields: [workId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([processStepId, workId])
  @@index([processStepId])
  @@index([workId])
  @@index([sortOrder])
}

model workGroup {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  operationId Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  operation   operation @relation(fields: [operationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  works       work[]

  @@unique([name, operationId])
  @@index([operationId])
}

model work {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  workGroupId Int
  tpz         Float
  tsht        Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workGroup   workGroup  @relation(fields: [workGroupId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  files       workFile[]
  processWorks processWork[]

  @@unique([name, workGroupId])
  @@index([workGroupId])
}

model operationFile {
  id           Int       @id @default(autoincrement())
  operationId  Int
  originalName String    @map("originalName")
  size         Int
  mimeType     String?   @map("mimeType")
  storagePath  String    @map("storagePath")
  createdAt    DateTime  @default(now())
  operation    operation @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([operationId])
}

model workFile {
  id           Int      @id @default(autoincrement())
  workId       Int
  originalName String   @map("originalName")
  size         Int
  mimeType     String?  @map("mimeType")
  storagePath  String   @map("storagePath")
  createdAt    DateTime @default(now())
  work         work     @relation(fields: [workId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([workId])
}
